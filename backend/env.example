# ===========================================
# Elastic Telemetry Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Server Port
PORT=3000

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=runtime-logs

# MySQL control-plane database, used to validate ingest API keys
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=elastic_telemetry

# Ingest hardening
INTERNAL_API_KEY=replace_with_openssl_rand_hex_32
REQUIRE_INTERNAL_API_KEY=true
REQUIRE_INGEST_API_KEY=true
LOG_RATE_LIMIT_WINDOW_MS=60000
LOG_RATE_LIMIT_MAX=1000
JSON_BODY_LIMIT=1mb
CORS_ORIGIN=http://localhost:3001

# Optional: Elasticsearch authentication (if enabled)
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=your_password

# ===========================================
# Elasticsearch Setup:
# ===========================================
# 1. Download Elasticsearch 9.x from elastic.co
# 2. Run: bin/elasticsearch
# 3. Default runs on http://localhost:9200
# 4. Optional: Run Kibana for visualization
#    - Download Kibana 9.x
#    - Run: bin/kibana
#    - Access at http://localhost:5601
# ===========================================
